#!/bin/sh
# 커밋하기 직전에 실행됩니다. 여기서 exit 1 이면 커밋이 취소됩니다.
. "$(dirname -- "$0")/common.sh"

BRANCH="$(git symbolic-ref --short -q HEAD)"

# 1) 보호 브랜치에는 직접 커밋할 수 없습니다.
if is_protected_branch "$BRANCH"; then
  say "🛑 '$BRANCH' 브랜치에는 직접 커밋할 수 없습니다.

  브랜치 전략:  작업 브랜치  →  develop  →  main

  먼저 작업 브랜치를 만드세요.
    git switch develop && git pull origin develop && git switch -c feat/작업이름

  Claude Code 를 쓴다면:  /start <만들고 싶은 것>"
  exit 1
fi

# 2) 진짜 비밀값(API 키, 비밀번호가 든 DB 주소)이 들어 있는 커밋은 막습니다.
#    BE 의 설정 파일(application-*.yml)에는 ${DATABASE_URL} 처럼 "값이 들어갈 자리" 만 적습니다.
#    찾는 모양:  sk- 로 시작하는 긴 글자(GPT 키)  /  postgresql://아이디:비밀번호@...
SECRET_PATTERN='(^|[^A-Za-z0-9])sk-[A-Za-z0-9_-]{20,}|postgres(ql)?://[A-Za-z0-9._-]+:[A-Za-z0-9._%+-]+@'

# 이번 커밋에 들어가는 파일을 하나씩 보면서, 새로 추가한 줄(+ 로 시작)에 위 모양이 있는지 찾습니다.
# 비밀값 자체는 화면에 찍지 않고 파일 이름만 모읍니다.
LEAKS="$(git diff --cached --name-only --diff-filter=ACMR | while IFS= read -r FILE; do
  if git diff --cached -U0 -- "$FILE" | grep -E '^\+' | grep -vE '^\+\+\+ ' | grep -qE "$SECRET_PATTERN"; then
    printf '    %s\n' "$FILE"
  fi
done)"

if [ -n "$LEAKS" ]; then
  say "🛑 비밀값처럼 보이는 글자가 들어 있어 커밋할 수 없습니다.

  들어 있는 파일:
$LEAKS

  API 키나 DB 비밀번호는 한 번 올라가면 기록에 영원히 남습니다.

  설정 파일에는 값 대신 자리만 적으세요.     예:  url: \${DATABASE_URL}
  고친 뒤에는 파일을 다시 담고 커밋하세요.   git add <파일>

  문서에 예시를 적는 중이라면 진짜처럼 보이지 않게 쓰세요.
    예:  sk-...     postgresql://아이디:비밀번호@주소"
  exit 1
fi
